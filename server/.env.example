# Contoh konfigurasi server. Salin menjadi .env lalu isi nilainya (.env tidak di-commit).
# PostgreSQL Connection
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/faedah_shop

# JWT Secret: buat dengan
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang

# Server Port
PORT=3001

# Upload directory (relatif terhadap folder server/)
UPLOAD_DIR=./uploads
